+// Temporary measurement hook. Removed before delivery, preserved in experiment.patch.
+fn experiment_audio(samples: &[f32], rate: u32) -> Option<Vec<f32>> {
+    match std::env::var("MY_VOICE_AUDIO_EXPERIMENT").ok().as_deref() {
